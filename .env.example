# Copy to .env (git-ignored) beside docker-compose.yml, fill in, then: docker compose up --build
# Your Claude API key. Leave empty to keep AI switched off.
ANTHROPIC_API_KEY=
# Any long random string. Type the same value into the app: Profile > Server > App key for AI.
APP_KEY=
AI_DAILY_LIMIT=100
AI_MONTHLY_CAP_USD=5
