# Copy to .env. Never commit real values.
DATABASE_URL=postgresql+psycopg://academy:academy@localhost:5432/academy
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=60
CONTENT_DIR=../content/build
ENVIRONMENT=development
# Phase 2 (AI). Leave ANTHROPIC_API_KEY empty to keep AI switched off.
ANTHROPIC_API_KEY=
# The personal app key the app sends in X-App-Key. Required in production.
APP_KEY=
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_STRONG=claude-sonnet-5-5
AI_DAILY_LIMIT=100
AI_MONTHLY_CAP_USD=5
# Dollars per million tokens as input,output. Take the real values from Anthropic's pricing page.
AI_PRICE_FAST=1,5
AI_PRICE_STRONG=3,15
