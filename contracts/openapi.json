  },
  "/v1/courses/{courseId}": {
   "get": {
    "operationId": "getCourse",
    "summary": "Full content of one course; supports If-None-Match",
    "tags": [
     "content"
    ],
    "x-rate-tier": "standard",
    "parameters": [
     {
      "name": "courseId",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "data"
         ],
         "properties": {
          "data": {
           "$ref": "#/components/schemas/Course"
          }
         }
        }
       }
      }
     },
     "304": {
      "description": "Not modified"
     },
     "default": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/v1/progress": {
   "get": {
    "operationId": "listProgress",
    "summary": "Progress records changed after a cursor",
    "tags": [
     "progress"
    ],
    "x-rate-tier": "standard",
    "parameters": [
     {
      "name": "since",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "nullable": true
      }
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "nullable": true
      }
     }
    ],
    "security": [
     {
      "bearer": []
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "data",
          "page"
         ],
         "properties": {
          "data": {
           "type": "array",
           "items": {
            "$ref": "#/components/schemas/ProgressRecord"
           }
          },
          "page": {
           "type": "object",
           "required": [
            "cursor"
           ],
           "properties": {
            "nextCursor": {
             "type": "integer",
             "nullable": true
            },
            "cursor": {
             "type": "integer"
            }
           }
          }
         }
        }
       }
      }
     },
     "default": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   },
   "put": {
    "operationId": "pushProgress",
    "summary": "Upsert progress records; newest updatedAt wins",
    "tags": [
     "progress"
    ],
    "x-rate-tier": "standard",
    "security": [
     {
      "bearer": []
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ProgressPush"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "data"
         ],
         "properties": {
          "data": {
           "$ref": "#/components/schemas/ProgressPushResult"
          }
         }
        }
       }
      }
     },
     "default": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/v1/ai/ask": {
