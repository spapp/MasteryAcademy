  "/v1/courses": {
   "get": {
    "operationId": "listCourses",
    "summary": "Course catalog with content versions",
    "tags": [
     "content"
    ],
    "x-rate-tier": "standard",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
