        }
       }
      }
     }
    }
   }
  },
  "/v1/ai/mark": {
   "post": {
    "operationId": "markAnswer",
    "summary": "Mark a typed answer to a quiz question, a lesson task or an interview question",
    "tags": [
     "ai"
    ],
    "x-rate-tier": "ai",
    "security": [
     {
      "appKey": []
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/MarkBody"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "data"
         ],
         "properties": {
          "data": {
           "$ref": "#/components/schemas/MarkResult"
          }
         }
        }
       }
      }
     },
     "default": {
      "description": "Error",
      "content": {
       "application/json": {
