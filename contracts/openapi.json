        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "User": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "format": "uuid"
     },
     "email": {
      "type": "string"
     },
     "displayName": {
      "type": "string"
     },
     "createdAt": {
      "type": "string",
      "format": "date-time"
     }
    },
    "required": [
     "id",
     "email",
     "displayName",
     "createdAt"
    ]
   },
   "Tokens": {
    "type": "object",
    "properties": {
     "accessToken": {
      "type": "string"
     },
     "refreshToken": {
      "type": "string"
     },
     "expiresIn": {
      "type": "integer"
     }
    },
    "required": [
     "accessToken",
     "refreshToken",
     "expiresIn"
    ]
   },
   "AuthResult": {
    "type": "object",
    "properties": {
     "user": {
      "$ref": "#/components/schemas/User"
     },
     "tokens": {
      "$ref": "#/components/schemas/Tokens"
     }
    },
    "required": [
     "user",
     "tokens"
    ]
   },
   "RegisterBody": {
    "type": "object",
    "properties": {
     "email": {
      "type": "string"
     },
     "password": {
      "type": "string"
     },
     "displayName": {
      "type": "string"
     }
    },
    "required": [
     "email",
     "password",
     "displayName"
    ]
   },
   "SessionBody": {
    "type": "object",
    "properties": {
     "email": {
      "type": "string"
     },
     "password": {
      "type": "string"
     },
     "deviceName": {
      "type": "string",
      "nullable": true
     }
    },
    "required": [
     "email",
     "password"
    ]
   },
   "RefreshBody": {
    "type": "object",
    "properties": {
     "refreshToken": {
      "type": "string"
     }
    },
    "required": [
     "refreshToken"
    ]
   },
   "CourseSummary": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "subtitle": {
      "type": "string"
     },
     "icon": {
      "type": "string"
     },
     "tint": {
      "type": "string"
     },
     "group": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "artifactURL": {
      "type": "string",
      "nullable": true
     },
     "note": {
      "type": "string",
      "nullable": true
     },
     "version": {
      "type": "string"
     },
     "lessonCount": {
      "type": "integer"
     },
     "questionCount": {
      "type": "integer"
     },
     "quizCount": {
      "type": "integer"
     },
     "minutes": {
      "type": "integer"
     },
     "web": {
      "type": "string",
      "nullable": true
     }
    },
    "required": [
     "id",
     "title",
     "subtitle",
     "icon",
     "tint",
     "group",
     "status",
     "version",
     "lessonCount",
     "questionCount",
     "quizCount",
     "minutes"
    ]
   },
   "Catalog": {
    "type": "object",
    "properties": {
     "schemaVersion": {
      "type": "integer"
     },
     "courses": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/CourseSummary"
      }
     }
    },
    "required": [
     "schemaVersion",
     "courses"
    ]
   },
   "Course": {
    "type": "object",
    "description": "Content schema v1, see kb/00-core/04-content-schema.md",
    "additionalProperties": true
   },
   "ProgressRecord": {
    "type": "object",
    "properties": {
     "courseId": {
      "type": "string"
     },
     "kind": {
      "type": "string",
      "enum": [
       "lesson",
       "quiz",
       "card",
       "bookmark"
      ]
     },
     "itemId": {
      "type": "string"
     },
     "done": {
      "type": "boolean"
     },
     "score": {
      "type": "integer",
      "nullable": true
     },
     "total": {
      "type": "integer",
      "nullable": true
     },
     "updatedAt": {
      "type": "string",
      "format": "date-time"
     }
    },
    "required": [
     "courseId",
     "kind",
     "itemId",
     "done",
     "updatedAt"
    ]
   },
   "ProgressPush": {
    "type": "object",
    "properties": {
     "records": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/ProgressRecord"
      }
     }
    },
    "required": [
     "records"
    ]
   },
   "ProgressPushResult": {
    "type": "object",
    "properties": {
     "applied": {
      "type": "integer"
     },
     "stale": {
      "type": "integer"
     },
     "cursor": {
      "type": "integer"
     }
    },
    "required": [
     "applied",
     "stale",
     "cursor"
    ]
   },
   "Health": {
    "type": "object",
    "properties": {
     "status": {
      "type": "string"
     },
     "database": {
      "type": "string"
     },
     "courses": {
      "type": "integer"
     }
    },
    "required": [
     "status",
     "database",
     "courses"
    ]
   },
   "AiUsage": {
    "type": "object",
    "properties": {
     "enabled": {
      "type": "boolean"
     },
     "requestsToday": {
      "type": "integer"
     },
     "dailyLimit": {
      "type": "integer"
     },
     "monthCostCents": {
      "type": "integer"
     },
     "monthlyCapCents": {
      "type": "integer"
     }
    },
    "required": [
     "enabled",
     "requestsToday",
     "dailyLimit",
     "monthCostCents",
     "monthlyCapCents"
    ]
   },
   "SectionRef": {
    "type": "object",
    "properties": {
     "blockIndex": {
      "type": "integer"
     },
     "title": {
      "type": "string"
     }
    },
    "required": [
     "blockIndex",
     "title"
    ]
   },
   "AskBody": {
    "type": "object",
    "properties": {
     "courseId": {
      "type": "string"
     },
     "lessonId": {
      "type": "string"
     },
     "mode": {
      "type": "string",
      "enum": [
       "tutor",
       "explain"
      ]
     },
     "question": {
      "type": "string",
      "nullable": true
     },
     "blockIndex": {
      "type": "integer",
      "nullable": true
     },
     "depth": {
      "type": "string",
      "nullable": true
     }
    },
    "required": [
     "courseId",
     "lessonId",
     "mode"
    ]
   },
   "AskResult": {
    "type": "object",
    "properties": {
     "answer": {
      "type": "string"
     },
     "covered": {
      "type": "boolean"
     },
     "sections": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/SectionRef"
      }
     },
     "usage": {
      "$ref": "#/components/schemas/AiUsage"
     }
    },
    "required": [
     "answer",
     "covered",
     "sections",
     "usage"
    ]
   },
   "QuizBody": {
    "type": "object",
    "properties": {
     "courseId": {
      "type": "string"
     },
     "lessonId": {
      "type": "string"
     },
     "count": {
      "type": "integer",
      "nullable": true
     }
    },
    "required": [
     "courseId",
     "lessonId"
    ]
   },
   "QuizResult": {
    "type": "object",
    "properties": {
     "questions": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "usage": {
      "$ref": "#/components/schemas/AiUsage"
     }
    },
    "required": [
     "questions",
     "usage"
    ]
   },
   "MarkBody": {
