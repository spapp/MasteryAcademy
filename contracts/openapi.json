        }
       }
      }
     }
    }
   }
  },
  "/v1/ai/usage": {
   "get": {
    "operationId": "getAiUsage",
    "summary": "AI requests used today and cost this month against the limits",
    "tags": [
     "ai"
    ],
    "x-rate-tier": "standard",
    "security": [
     {
      "appKey": []
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "data"
         ],
         "properties": {
          "data": {
           "$ref": "#/components/schemas/AiUsage"
          }
         }
        }
       }
